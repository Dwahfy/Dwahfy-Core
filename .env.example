# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# Used by docker-compose.yml (postgres + core + web) and by Dwahfy-Core/
# Dwahfy-Web when running them directly with `npm run dev`.

# ── Images (self-hosting) ────────────────────────────────
# Which prebuilt images `docker compose up` pulls.
CORE_IMAGE=ghcr.io/dwahfy/dwahfy-core:latest
# Defaults to the open-source Communuity-Web-UI. Point this at your own
# fork/image (any UI that speaks the Dwahfy-Core API) to swap frontends.
WEB_IMAGE=communuity-web-ui:local

# ── Server (Dwahfy-Core) ──────────────────────────────────
PORT=8000
UPLOADS_DIR=/app/uploads
NODE_ENV=production
APP_BASE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
# For local dev (running Node directly, not Docker):
DATABASE_URL=postgres://postgres:change-me@localhost:5432/dwahfy_prod

# For Docker, POSTGRES_PASSWORD builds the connection string automatically —
# you don't need to set DATABASE_URL yourself.
POSTGRES_PASSWORD=change-me

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me
# Salts OTP hashes; falls back to JWT_SECRET if unset
OTP_SECRET=change-me

# ── SMTP (optional — OTPs print to console in dev if unset) ─
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-pass
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=false

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# ── Moderation ────────────────────────────────────────────
BAD_WORDS_ENABLED=true

# ── GIFs (Klipy) ──────────────────────────────────────────
# Get a key at https://partner.klipy.com/
KLIPY_API_KEY=change-me

# ── Admin ─────────────────────────────────────────────────
# Generate with: bash Dwahfy-Core/scripts/gen-admin-key.sh
ADMIN_API_KEY=change-me
# Promotes this username to admin on startup
BOOTSTRAP_ADMIN_USERNAME=change-me

# ── Beta gating ───────────────────────────────────────────
BETA_MODE=false
NEXT_PUBLIC_BETA_MODE=false

# ── Frontend (Dwahfy-Web) ─────────────────────────────────
# Browser-facing API URL — baked in at build time for Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
# Newsletter signup (optional)
BEEHIIV_API_KEY=change-me
BEEHIIV_PUBLICATION_ID=change-me
