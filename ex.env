# Copy this to .env and fill in your values
# cp ex.env .env

# ── Server ────────────────────────────────────────────────
PORT=8000
# Public-facing base URL of this API — used to build avatar URLs returned to clients
APP_BASE_URL=https://api.yourdomain.com
UPLOADS_DIR=/app/uploads
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# For local dev (running Node directly):
DATABASE_URL=postgres://postgres:change-me@localhost:5432/dwahfy_prod

# For Docker self-hosting, POSTGRES_PASSWORD is used to build the connection
# string automatically — you don't need to set DATABASE_URL manually.
POSTGRES_PASSWORD=change-me

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me
# Used to salt OTP hashes — generate with: openssl rand -hex 32
# Falls back to JWT_SECRET if unset, but setting it separately is safer
OTP_SECRET=change-me

# ── SMTP (optional) ───────────────────────────────────────
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-pass
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=false

# ── CORS ──────────────────────────────────────────────────
# Set to the URL of your frontend
CORS_ORIGIN=http://localhost:3000

# ── Moderation ────────────────────────────────────────────
# BAD_WORDS_ENABLED=true

# ── Docker self-hosting only ──────────────────────────────
# Your frontend image — self-hosters replace this with their own
WEB_IMAGE=your-dockerhub-user/your-web:latest

# Admin panel API key
ADMIN_API_KEY=change-me

# ── GIF service ───────────────────────────────────────────
# Klipy API key — required for GIF search/trending endpoints
KLIPY_API_KEY=change-me
