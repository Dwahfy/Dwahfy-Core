# Copy this to .env and fill in your values
# cp ex.env .env

# ── Server ────────────────────────────────────────────────
PORT=8000
UPLOADS_DIR=/app/uploads
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# For local dev (running Node directly):
DATABASE_URL=postgres://postgres:change-me@localhost:5432/dwahfy_prod

# For Docker self-hosting, POSTGRES_PASSWORD is used to build the connection
# string automatically — you don't need to set DATABASE_URL manually.
POSTGRES_PASSWORD=change-me

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me

# ── SMTP (optional) ───────────────────────────────────────
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-pass
# SMTP_FROM=no-reply@example.com
# SMTP_SECURE=false

# ── CORS ──────────────────────────────────────────────────
# Set to the URL of your frontend
CORS_ORIGIN=http://localhost:3000

# ── Moderation ────────────────────────────────────────────
# BAD_WORDS_ENABLED=true

# ── GIFs (Klipy) ──────────────────────────────────────────
# Get a key at https://partner.klipy.com/
KLIPY_API_KEY=change-me

# ── Docker self-hosting only ──────────────────────────────
# Your frontend image — self-hosters replace this with their own
WEB_IMAGE=your-dockerhub-user/your-web:latest

# Admin panel API key
ADMIN_API_KEY=change-me
